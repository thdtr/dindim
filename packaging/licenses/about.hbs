<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>dindim third party licenses</title>
<style>
  body { font: 15px/1.5 system-ui, sans-serif; max-width: 860px; margin: 40px auto; padding: 0 16px; color: #1c1b19; }
  pre { white-space: pre-wrap; background: #f5f3ee; padding: 12px; border-radius: 8px; font-size: 13px; }
  li { margin: 2px 0; }
</style>
</head>
<body>
<h1>Third party licenses</h1>
<p>dindim is built on the work of many open source projects. Their licenses are listed below.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licenses</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
  {{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
  {{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
