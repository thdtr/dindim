#include <winver.h>

1 ICON "../../assets/icons/dindim.ico"

VS_VERSION_INFO VERSIONINFO
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "dindim contributors"
      VALUE "FileDescription", "dindim"
      VALUE "InternalName", "dindim"
      VALUE "LegalCopyright", "Apache License 2.0"
      VALUE "OriginalFilename", "dindim.exe"
      VALUE "ProductName", "dindim"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
